# %ECSV 1.0
# ---
# datatype:
# - {name: filter, datatype: string, description: WFI filter name}
# - {name: RCSLEDBand, datatype: int64, description: RCS LEDP band}
# - {name: RCSLEDSpectrumWavelength, unit: nm, datatype: float64, description: Wavelength at which the LEDP spectral output was measured}
# - {name: RCSLEDSpectrumRelativeOutput, unit: '%', datatype: float64, description: LEDP spectral output relative to the band's peak output
#     (peak = 100%); values below zero reflect measurement noise in the wings of the spectrum}
# delimiter: ','
# meta: !!omap
# - comments: ['Roman WFI Relative Calibration System (RCS) LEDP spectral energy distribution: relative spectral output vs. wavelength
#       for each LEDP band, normalized so each band''s peak output is 100%. Each band was measured over its own wavelength scan window
#       (bands are paired: 1-2, 3-4, 5-6 share a scan window), so wavelength sampling and range differ by band -- this table is in long
#       format (one row per band per sample) rather than a single shared wavelength grid.']
# - {last updated: 2024-Oct-25}
# - __serialized_columns__:
#     RCSLEDSpectrumRelativeOutput:
#       __class__: astropy.units.quantity.Quantity
#       unit: !astropy.units.Unit {unit: '%'}
#       value: !astropy.table.SerializedColumn {name: RCSLEDSpectrumRelativeOutput}
